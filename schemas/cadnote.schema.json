{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadview.org/schemas/cadnote.schema.json",
  "title": "CADView annotation document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_fingerprint", "annotations"],
  "properties": {
    "schema_version": { "const": 1 },
    "source_fingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "color_argb", "geometry", "created_at_epoch_ms", "updated_at_epoch_ms"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "author": { "type": ["string", "null"] },
          "color_argb": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "geometry": { "type": "object", "required": ["kind"] },
          "created_at_epoch_ms": { "type": "integer" },
          "updated_at_epoch_ms": { "type": "integer" }
        }
      }
    }
  }
}
